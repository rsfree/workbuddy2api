{
  "listen": ":7863",
  "api_key": "test_key",
  "auth_dir": "./auths",
  "state_file": "./data/state.json",
  "dns_servers": [],
  "server": {
    "read_timeout": "300s"
  },
  "panel": {
    "package_detail_limit": 5
  },
  "logging": {
    "request_archive_enabled": true,
    "request_retention_days": 7,
    "request_archive_max_mb": 100,
    "request_client_info": true
  },
  "cooldown": {
    "soft_rate": "600s",
    "soft_rate_max": "2h"
  },
  "schedule": {
    "checkin_hours": [9, 21],
    "growth_hours": [1],
    "travel_hours": [9, 21],
    "activity_hours": [10],
    "keepalive_hours": [22],
    "blackcat_hours": [23],
    "checkin_enabled": true,
    "growth_enabled": true,
    "travel_enabled": true,
    "activity_enabled": true,
    "keepalive_enabled": true,
    "blackcat_enabled": true,
    "balance_refresh_enabled": true,
    "balance_refresh_minutes": 5,
    "include_disabled_in_tasks": false,
    "new_account_grace_days": 3
  },
  "global": {
    "enabled": true,
    "chat_base": "",
    "billing_base": ""
  },
  "cn": {
    "chat_base": ""
  },
  "images": {
    "_comment": "OpenAI 兼容图像接口 /v1/images/generations 与 /v1/images/edits。模型名对齐服务端目录：文生图 hunyuan-image-alpha（已开通新版可改 hunyuan-image-v3.0），图生图 hunyuan-image-alpha-edit。fallback_model 留空 = 未知模型交给上游判定；list_in_models=true（默认）会把上游动态探测到的图像/视频模型附到 /v1/models 末尾（带 type/endpoint），?refresh=1 可强制立即刷新。",
    "enabled": true,
    "default_model": "hunyuan-image-alpha",
    "edit_model": "hunyuan-image-alpha-edit",
    "fallback_model": "",
    "deadline_seconds": 420,
    "max_ref_images": 5,
    "fetch_source_ip": "",
    "list_in_models": true
  },
  "egress": {
    "_comment": "出口隔离（风控）。mode=direct 关闭；local=本机多 IP（ips 留空自动发现，按账号 hash 分配）；static=共用代理；pool-keyed/pool-pin=自建 SOCKS5 池。敏感项（host/password/salt）建议只走环境变量 WB2A_EGRESS_HOST / WB2A_EGRESS_PASSWORD / WB2A_EGRESS_SALT，不要写进本文件。",
    "mode": "local",
    "static_url": "",
    "local": {
      "ips": [],
      "interfaces": [],
      "include_ipv6": false,
      "exclude_prefixes": []
    },
    "pool": {
      "host": "",
      "password": "",
      "password_env": "WB2A_EGRESS_PASSWORD",
      "username_template": "acct-{uid}",
      "salt": "",
      "salt_env": "WB2A_EGRESS_SALT",
      "keyed_port": 2090,
      "pin_base_port": 1188,
      "pin_slots": 16,
      "round_port": 2088
    },
    "identity_source": "uid",
    "group_by": "account",
    "groups": {},
    "fail_threshold": 5,
    "fail_cooldown": "60s",
    "max_transports": 64
  },
  "upstream": {
    "timeout_seconds": 120,
    "header_timeout_seconds": 120,
    "idle_timeout_seconds": 300,
    "user_agent": "",
    "client_version": "",
    "cli_version": "",
    "client_name": "",
    "device_token": "",
    "device_token_file": "",
    "passthrough_ip": false
  },
  "features": {
    "sanitize_blacklist_fingerprints": true
  },
  "models": {
    "_comment": "hidden: 不对外暴露的模型黑名单。裸名=两域都藏；\"cn:xxx\"/\"global:xxx\"=只藏该域。/v1/models 列表过滤 + chat 点名拒绝，面板保存后热生效。extra: 静态补录，把上游账号目录里没有的模型列进 /v1/models（裸名归 cn；type=image/video 自动带端点字段），hidden 优先。注意：补录只影响列表呈现，上游没路由时调用仍会失败（如生图返回 14401 route config not found）。",
    "hidden": [],
    "extra": []
  },
  "prompt": {
    "mode": "passthrough",
    "file": ""
  },
  "upstash": {
    "url": "",
    "token": ""
  },
  "pool": {
    "strategy": {
      "domestic": "weighted_random",
      "international": "weighted_random"
    },
    "account_order": {
      "domestic": [],
      "international": []
    },
    "max_in_flight": 3,
    "max_in_flight_global": 2,
    "breaker_threshold": 3,
    "breaker_cooldown": "30m",
    "breaker_cooldown_max": "6h",
    "degrade_threshold": 5,
    "degrade_cooldown": "10m",
    "degrade_cooldown_max": "2h",
    "idle_weight_per_hour": 0.5,
    "idle_weight_max": 5.0,
    "prefer_expiring": true,
    "expiring_soon": "168h",
    "cost_explore_interval": "30m",
    "credit_floor": 100,
    "cross_domain_fallback": false
  },
  "session_sticky": {
    "enabled": true,
    "ttl": "30m",
    "gc_interval": "5m",
    "prefix_affinity": true,
    "state_file": "",
    "persist_interval": "30s"
  }
}
